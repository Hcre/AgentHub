# === Backend 本地开发环境变量 ===
ENV=development
DEBUG=true

# --- 数据库（本地直连）---
DATABASE_URL=postgresql+asyncpg://agenthub:agenthub_dev_pwd@localhost:5432/agenthub

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- 安全 ---
# AES-256-GCM 密钥：32 字节 base64。生成：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
SECRET_KEY=CHANGE_ME_base64_32bytes
JWT_SECRET=CHANGE_ME_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- LLM Adapter ---
# claude_cli | anthropic_api | mock
LLM_ADAPTER_MODE=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL=claude-sonnet-4-20250514

# --- 上下文 / 记忆 ---
L1_WINDOW_SIZE=20

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
