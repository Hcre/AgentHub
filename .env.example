# === 根级环境变量（Docker Compose 读取）===

# --- PostgreSQL ---
POSTGRES_USER=agenthub
POSTGRES_PASSWORD=agenthub_dev_pwd
POSTGRES_DB=agenthub

# --- Redis ---
REDIS_PASSWORD=

# --- Backend ---
# AES-256-GCM 密钥（32 字节 base64），用于 Agent api_key 加密存储；生产务必替换
SECRET_KEY=CHANGE_ME_32_bytes_base64_key_here_xxxxxxxxxx=
JWT_SECRET=CHANGE_ME_jwt_secret
# 默认 LLM Provider Key（可选；Agent 级别可单独配置）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Adapter 模式：claude_cli | anthropic_api | mock（无 Key 时用 mock 跑通流程）
LLM_ADAPTER_MODE=mock

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
